# ---- Required ----
DISCORD_BOT_TOKEN=your_discord_bot_token_here
ANTHROPIC_API_KEY=sk-ant-...

# ---- News sources (optional; RSS works with no keys) ----
NEWSAPI_KEY=your_newsapi_key
GNEWS_KEY=your_gnews_key

# ---- Crypto price API (optional; CoinGecko public API works with no key) ----
COINGECKO_API_KEY=

# ---- Discord channel IDs for auto-push alerts ----
CHANNEL_ID_US=1522684149893169222
CHANNEL_ID_ID=1522684219145457864
CHANNEL_ID_CRYPTO=1522684243828936804

# ---- Behaviour ----
POLL_INTERVAL_MINUTES=15
# Max articles actually POSTED per market per poll.
MAX_ARTICLES_PER_POLL=3
# Max articles ANALYZED per market per poll (bounds LLM cost).
MAX_SCAN_PER_POLL=15
# Only auto-push at or above this impact: high, medium, or low.
MIN_IMPACT=high
ANALYSIS_MODEL=claude-haiku-4-5
DB_PATH=bot.db

# ---- Keyword pre-filter (free gate before the LLM) ----
# true = only spend an LLM call on articles mentioning a market-moving keyword.
PREFILTER_ENABLED=true
# Optional: comma-separated override of the default keyword list. Leave blank
# to use the built-in defaults in config.py.
# PREFILTER_KEYWORDS=cpi,inflation,fed,rate decision,sanction,war,earnings
