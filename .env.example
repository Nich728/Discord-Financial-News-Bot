# ---- Required ----
DISCORD_BOT_TOKEN=your_discord_bot_token_here
ANTHROPIC_API_KEY=sk-ant-...
# Jev (TypeSafe) — optional shadow classifier alongside Haiku
TYPESAFE_API_KEY=
JEV_ENABLED=true

# ---- Crypto price API (optional; CoinGecko public API works with no key) ----
COINGECKO_API_KEY=

# ---- Discord channel IDs for auto-push alerts ----
CHANNEL_ID_US=1522684149893169222
CHANNEL_ID_ID=1522684219145457864
CHANNEL_ID_CRYPTO=1522684243828936804
# World/international news that doesn't fit US, ID, or crypto.
CHANNEL_ID_GLOBAL=1532444109271335122

# ---- Behaviour ----
POLL_INTERVAL_MINUTES=15
# Max articles actually POSTED per market per poll.
MAX_ARTICLES_PER_POLL=3
# Max articles ANALYZED per market per poll (bounds LLM cost).
MAX_SCAN_PER_POLL=15
# Only auto-push at or above this impact: high, medium, or low.
MIN_IMPACT=high
ANALYSIS_MODEL=claude-haiku-4-5
DB_PATH=bot.db
# Set true on an IPv4-only host (e.g. a droplet without IPv6) so feeds that
# resolve to IPv6 first don't fail with "Network is unreachable".
FORCE_IPV4=false

# ---- Keyword pre-filter (free gate before the LLM) ----
# true = only spend an LLM call on articles mentioning a market-moving keyword.
PREFILTER_ENABLED=true
# Optional: comma-separated override of the default keyword list. Leave blank
# to use the built-in defaults in config.py.
# PREFILTER_KEYWORDS=cpi,inflation,fed,rate decision,sanction,war,earnings

# ---- Gate audit (QA, off by default) ----
# true = also classify gate-dropped articles and warn (console + gate_audit.log)
# if any were actually high-impact, so you can spot missing keywords.
# Costs extra LLM calls — turn on to tune the keyword list, then turn off.
AUDIT_GATE=false
AUDIT_MAX=10

# ---- Trusted sources ----
# Curated outlets that bypass the keyword gate and post at a lower impact bar.
# Comma-separated substrings matched against each article's source name/URL.
# Leave blank to use the default (Bloomberg Technoz).
# TRUSTED_SOURCES=bloomberg technoz,reuters
TRUSTED_MIN_IMPACT=medium
